{
	"name": "app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "bunx biome check",
		"format": "bunx biome format --write",
		"proto:gen": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto.exe --ts_proto_out=./lib/proto --ts_proto_opt=esModuleInterop=true,outputServices=false,useOptionals=messages,oneof=unions,forceLong=bigint -I proto proto/chat.proto"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"lucide-react": "^1.74.0",
		"next": "16.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "4.3.3",
		"ts-proto": "^2.23.8",
		"typescript": "^5"
	},
	"packageManager": "bun@1.4.4",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
